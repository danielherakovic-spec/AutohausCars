# PLACEHOLDERS ONLY. Never put real secrets in the website/GitHub folder.
# Prefer Dashboard > Edge Functions > Secrets for production.
OPENAI_API_KEY=
# Explicitly choose an API model with Responses + strict JSON Schema support.
OPENAI_MODEL=
# Exact browser origins, no paths/trailing slash/wildcards; comma-separated.
ANALYSIS_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io
# SUPABASE_URL and public API keys are supplied by Supabase automatically.
# No service-role key is needed by this feature.
